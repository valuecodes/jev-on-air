# Copy to .env (git-ignored) and fill in. Loaded by `pnpm cli`; values already
# in the environment win.

# Alpaca API keys for `pnpm cli prices`. Keys from a paper-trading account work
# for market data: https://app.alpaca.markets → Paper → API Keys.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# TypeSafe AI API key for `pnpm cli jev`: https://typesafe.ai
TYPESAFE_API_KEY=
# TypeSafe model Jev decides with (default jev-latest).
# JEV_MODEL=jev-latest
