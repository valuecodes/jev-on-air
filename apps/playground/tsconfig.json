{
  "extends": "@repo/typescript/react.json",
  "include": ["src"],
  "exclude": ["node_modules"],
  "compilerOptions": {
    // `vite/client` declares the `*.css` (and other asset) modules that
    // `import "./globals.css"` relies on. Without it TypeScript 7 rejects the
    // side-effect import with TS2882.
    "types": ["vite/client"]
  }
}
