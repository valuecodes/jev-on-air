{
  "extends": "@repo/typescript/react.json",
  "compilerOptions": {
    "types": ["node"],
    "plugins": [{ "name": "next" }],
    // `~/` is the only way up the tree: oxlint bans `../` imports.
    "paths": { "~/*": ["./src/*"] }
  },
  "include": ["next-env.d.ts", "src", ".next/types/**/*.ts"],
  "exclude": ["node_modules", ".next/cache"]
}
