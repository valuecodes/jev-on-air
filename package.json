{
  "name": "jev-on-air",
  "description": "Monitors livestreams, transcribes speech, and turns market-moving statements detected by Jev into simulated trade signals",
  "private": true,
  "engines": {
    "node": "^24.22.1 || >=26.12.1"
  },
  "packageManager": "pnpm@12.12.1+sha512.b7f98934c0b1f29a65f5da52f2d7f994e7faad573ffdddea1497fb4dcb5aec051590ee7c7d95a38172b4bfae103a5b83edf2ee866e11731c2cafa96063610ac5",
  "scripts": {
    "dev": "turbo run dev",
    "cli": "pnpm --silent --filter cli start",
    "desk": "pnpm --filter desk dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "oxlint --type-aware --report-unused-disable-directives",
    "test": "turbo run test",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "knip": "knip",
    "clean": "turbo run clean",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config --local core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "knip": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  }
}
